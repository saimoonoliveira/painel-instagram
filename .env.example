# Referência dos secrets das funções. NÃO preencha este arquivo:
# rode `bash instalar/segredos.sh`, que grava tudo direto no Supabase (veja INSTALAR.md).

INSTAGRAM_APP_ID=       # ID do app do Instagram (painel da Meta)
META_APP_SECRET=        # chave secreta do app do Instagram (valida o webhook e troca o código do login)
META_VERIFY_TOKEN=      # gerado pelo script; o mesmo valor vai no webhook do painel da Meta
OAUTH_REDIRECT_URI=     # https://<ref>.supabase.co/functions/v1/oauth
PAINEL_URL=             # endereço do painel na Vercel
VIGIAR_KEY=             # gerado; igual ao vigiar_key do Vault (agendador do Monitor)
PUBLICAR_KEY=           # gerado; igual ao publicar_key do Vault (agendador de posts)
METRICAS_KEY=           # gerado; só para apps externos lerem métricas
APIFY_TOKEN=            # opcional: aba Monitor
GRAPH_VERSION=          # opcional (padrão v23.0)
