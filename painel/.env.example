# Copie para .env e preencha com os dados do SEU projeto Supabase
# (Project Settings > API). A anon key pode ir no frontend; ela respeita o RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ID do SEU app da Meta (painel da Meta > seu app > Instagram > ID do app do Instagram)
VITE_INSTAGRAM_APP_ID=
# Nome que aparece no painel (opcional)
VITE_NOME_APP="Painel Instagram"
